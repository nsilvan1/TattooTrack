# ===========================================
# TattooTrack Backend - Variáveis de Ambiente
# ===========================================
# Copie este arquivo para .env e preencha os valores

# Porta do servidor
PORT=3333

# ===========================================
# BANCO DE DADOS (Obrigatório)
# ===========================================
# MongoDB - Use MongoDB Atlas (gratuito) ou local
#
# MongoDB Atlas (recomendado):
#   1. Crie conta em https://www.mongodb.com/atlas
#   2. Crie um cluster gratuito (M0)
#   3. Em "Database Access", crie um usuário
#   4. Em "Network Access", adicione seu IP (ou 0.0.0.0/0 para todos)
#   5. Em "Connect", copie a connection string
#
# MongoDB Local:
#   DATABASE_URL="mongodb://localhost:27017/tattootrack"

DATABASE_URL="mongodb+srv://usuario:senha@clustermongodb+srv://nsnunes:magbserv01@frisck.8lr5dxi.mongodb.net/.mongodb.net/tattootrack?retryWrites=true&w=majority"

# ===========================================
# AUTENTICAÇÃO (Obrigatório)
# ===========================================
# JWT Secret - Use uma string longa e aleatória
# Gere uma em: https://generate-secret.vercel.app/32
# IMPORTANTE: Mude em produção!

JWT_SECRET=mude_esta_chave_secreta_em_producao_123456

# ===========================================
# CORS (Obrigatório)
# ===========================================
# URL do frontend (para permitir requisições)
# Desenvolvimento: http://localhost:5173
# Produção: https://seu-dominio.vercel.app

FRONTEND_URL=http://localhost:5173

# ===========================================
# GOOGLE OAUTH (Opcional)
# ===========================================
# Para integração com Google Calendar
#
# Como configurar:
#   1. Acesse https://console.cloud.google.com/
#   2. Crie ou selecione um projeto
#   3. Ative a "Google Calendar API" em APIs & Services
#   4. Em "Credentials", crie "OAuth 2.0 Client ID"
#   5. Tipo: Web application
#   6. Authorized redirect URIs:
#      - Dev: http://localhost:3333/api/auth/google/callback
#      - Prod: https://seu-dominio.vercel.app/api/auth/google/callback
#   7. Copie Client ID e Client Secret

GOOGLE_CLIENT_ID=seu_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=seu_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3333/api/auth/google/callback
